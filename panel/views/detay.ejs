<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📋 <%= kanun.baslik %> - Cumhuriyet RP Bot v1.1.0</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #1e3c72 100%);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Arka plan animasyonu */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 25% 25%, rgba(74, 144, 226, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 75% 75%, rgba(56, 102, 177, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 50% 10%, rgba(30, 60, 114, 0.1) 0%, transparent 50%);
            animation: wave-bg 15s ease-in-out infinite;
        }

        @keyframes wave-bg {
            0%, 100% { 
                opacity: 0.3;
                transform: scale(1) rotate(0deg);
            }
            50% { 
                opacity: 0.8;
                transform: scale(1.1) rotate(5deg);
            }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
            animation: slideInDown 1s ease-out;
        }

        @keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header h1 {
            font-size: 2.8rem;
            font-weight: 700;
            color: white;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            margin-bottom: 1rem;
            animation: glow-detail 4s ease-in-out infinite alternate;
        }

        @keyframes glow-detail {
            from {
                text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 30px rgba(74, 144, 226, 0.3);
            }
            to {
                text-shadow: 0 4px 30px rgba(0, 0, 0, 0.7), 0 0 60px rgba(74, 144, 226, 0.7);
            }
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            animation: fadeIn 1.5s ease-out;
        }

        .breadcrumb a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .breadcrumb a:hover {
            color: white;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        .breadcrumb span {
            margin: 0 1rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .main-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .kanun-detay {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            animation: slideInLeft 1s ease-out;
            position: relative;
            overflow: hidden;
        }

        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .kanun-detay::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.8s ease;
        }

        .kanun-detay:hover::before {
            left: 100%;
        }

        .kanun-title {
            font-size: 2.2rem;
            font-weight: 700;
            color: #1e3c72;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 3px solid #74b9ff;
            position: relative;
        }

        .kanun-title::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 0;
            width: 100px;
            height: 3px;
            background: linear-gradient(45deg, #74b9ff, #0984e3);
            animation: expand 3s ease-in-out infinite;
        }

        @keyframes expand {
            0%, 100% { width: 100px; }
            50% { width: 200px; }
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .detail-item {
            background: rgba(116, 185, 255, 0.1);
            padding: 1.5rem;
            border-radius: 15px;
            border-left: 4px solid #74b9ff;
            transition: all 0.3s ease;
            animation: fadeInUp 0.8s ease-out;
            animation-fill-mode: both;
        }

        .detail-item:nth-child(1) { animation-delay: 0.1s; }
        .detail-item:nth-child(2) { animation-delay: 0.2s; }
        .detail-item:nth-child(3) { animation-delay: 0.3s; }
        .detail-item:nth-child(4) { animation-delay: 0.4s; }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .detail-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            background: rgba(116, 185, 255, 0.2);
        }

        .detail-label {
            font-weight: 700;
            color: #1e3c72;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .detail-value {
            color: #2d3436;
            font-size: 1.1rem;
        }

        .status-badge {
            display: inline-block;
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            font-weight: 700;
            text-transform: uppercase;
            animation: status-breathing 3s ease-in-out infinite;
        }

        @keyframes status-breathing {
            0%, 100% {
                transform: scale(1);
                opacity: 0.9;
            }
            50% {
                transform: scale(1.05);
                opacity: 1;
            }
        }

        .status-taslak { background: linear-gradient(45deg, #f39c12, #e67e22); color: white; }
        .status-oylamada { background: linear-gradient(45deg, #3498db, #2980b9); color: white; }
        .status-yururlukte { background: linear-gradient(45deg, #27ae60, #219a52); color: white; }
        .status-reddedildi { background: linear-gradient(45deg, #e74c3c, #c0392b); color: white; }

        .icerik-section {
            background: rgba(255, 255, 255, 0.9);
            padding: 2rem;
            border-radius: 20px;
            margin-top: 2rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            animation: slideInUp 1s ease-out 0.5s both;
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .icerik-section h3 {
            font-size: 1.5rem;
            color: #1e3c72;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .icerik-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #2d3436;
            background: rgba(116, 185, 255, 0.05);
            padding: 1.5rem;
            border-radius: 15px;
            border-left: 4px solid #74b9ff;
        }

        .chart-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            padding: 2rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            animation: slideInRight 1s ease-out;
            position: sticky;
            top: 2rem;
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .chart-title {
            font-size: 1.8rem;
            color: #1e3c72;
            margin-bottom: 1.5rem;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .chart-wrapper {
            position: relative;
            animation: pulse-chart 4s ease-in-out infinite;
        }

        @keyframes pulse-chart {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(116, 185, 255, 0.4);
            }
            50% {
                transform: scale(1.02);
                box-shadow: 0 0 0 20px rgba(116, 185, 255, 0);
            }
        }

        #oyGrafiği {
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .vote-summary {
            margin-top: 1.5rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .vote-item {
            text-align: center;
            padding: 1rem;
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .vote-evet {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
            color: white;
            animation: vote-glow-evet 3s ease-in-out infinite;
        }

        .vote-hayir {
            background: linear-gradient(45deg, #e74c3c, #f39c12);
            color: white;
            animation: vote-glow-hayir 3s ease-in-out infinite 1.5s;
        }

        @keyframes vote-glow-evet {
            0%, 100% {
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }
            50% {
                box-shadow: 0 10px 25px rgba(39, 174, 96, 0.7);
            }
        }

        @keyframes vote-glow-hayir {
            0%, 100% {
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
            }
            50% {
                box-shadow: 0 10px 25px rgba(231, 76, 60, 0.7);
            }
        }

        .vote-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .vote-label {
            font-size: 1rem;
            text-transform: uppercase;
            font-weight: 600;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin: 3rem 0;
        }

        .btn {
            padding: 1rem 2rem;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s ease;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
        }

        .btn-primary {
            background: linear-gradient(45deg, #74b9ff, #0984e3);
            color: white;
            animation: btn-shimmer 4s ease-in-out infinite;
        }

        .btn-secondary {
            background: linear-gradient(45deg, #636e72, #2d3436);
            color: white;
            animation: btn-shimmer 4s ease-in-out infinite 2s;
        }

        @keyframes btn-shimmer {
            0%, 100% {
                box-shadow: 0 5px 15px rgba(116, 185, 255, 0.4);
            }
            50% {
                box-shadow: 0 10px 25px rgba(116, 185, 255, 0.6);
            }
        }

        .btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        }

        .footer {
            text-align: center;
            margin-top: 3rem;
            padding: 2rem;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 15px;
            backdrop-filter: blur(10px);
            animation: fadeIn 2s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .footer img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            margin-bottom: 1rem;
            animation: rotate-logo 10s linear infinite;
        }

        @keyframes rotate-logo {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .footer-text {
            color: white;
            font-size: 1rem;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        }

        /* Mobil responsive */
        @media (max-width: 1024px) {
            .main-content {
                grid-template-columns: 1fr;
            }
            
            .chart-container {
                position: static;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
            
            .header h1 {
                font-size: 2rem;
            }
            
            .detail-grid {
                grid-template-columns: 1fr;
            }
            
            .vote-summary {
                grid-template-columns: 1fr;
            }
            
            .action-buttons {
                flex-direction: column;
            }
        }

        /* Özel scroll bar */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(45deg, #74b9ff, #0984e3);
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(45deg, #0984e3, #74b9ff);
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-balance-scale"></i> Kanun Detayları</h1>
            
            <div class="breadcrumb">
                <a href="/"><i class="fas fa-home"></i> Ana Sayfa</a>
                <span><i class="fas fa-chevron-right"></i></span>
                <span>Kanun Detayı</span>
            </div>
        </div>

        <div class="main-content">
            <div class="kanun-detay">
                <div class="kanun-title">
                    <i class="fas fa-gavel"></i> <%= kanun.baslik %>
                </div>

                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="fas fa-user"></i> Teklif Sahibi
                        </div>
                        <div class="detail-value"><%= kanun.teklif_sahibi %></div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="fas fa-flag"></i> Durum
                        </div>
                        <div class="detail-value">
                            <span class="status-badge status-<%= kanun.durum.toLowerCase() %>">
                                <% if (kanun.durum === 'Taslak') { %>
                                    <i class="fas fa-edit"></i> Taslak
                                <% } else if (kanun.durum === 'Oylamada') { %>
                                    <i class="fas fa-vote-yea"></i> Oylamada
                                <% } else if (kanun.durum === 'Yürürlükte') { %>
                                    <i class="fas fa-check-circle"></i> Yürürlükte
                                <% } else if (kanun.durum === 'Reddedildi') { %>
                                    <i class="fas fa-times-circle"></i> Reddedildi
                                <% } %>
                            </span>
                        </div>
                    </div>

                    <% if (kanun.yururluge_giris_sekli) { %>
                        <div class="detail-item">
                            <div class="detail-label">
                                <i class="fas fa-newspaper"></i> Yürürlüğe Giriş Şekli
                            </div>
                            <div class="detail-value"><%= kanun.yururluge_giris_sekli %></div>
                        </div>
                    <% } %>

                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="fas fa-calendar"></i> Oluşturulma Tarihi
                        </div>
                        <div class="detail-value"><%= new Date(kanun.zaman).toLocaleString('tr-TR') %></div>
                    </div>
                </div>

                <div class="icerik-section">
                    <h3><i class="fas fa-file-text"></i> Kanun İçeriği</h3>
                    <div class="icerik-text">
                        <%= kanun.icerik %>
                    </div>
                </div>
            </div>

            <div class="chart-container">
                <div class="chart-title">
                    <i class="fas fa-chart-pie"></i> Oy Dağılımı
                </div>
                
                <div class="chart-wrapper">
                    <canvas id="oyGrafiği" width="300" height="300"></canvas>
                </div>
                
                <div class="vote-summary">
                    <div class="vote-item vote-evet">
                        <div class="vote-number" id="evetSayisi">0</div>
                        <div class="vote-label">
                            <i class="fas fa-thumbs-up"></i> Evet
                        </div>
                    </div>
                    <div class="vote-item vote-hayir">
                        <div class="vote-number" id="hayirSayisi">0</div>
                        <div class="vote-label">
                            <i class="fas fa-thumbs-down"></i> Hayır
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="action-buttons">
            <a href="/" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> Ana Sayfaya Dön
            </a>
            <a href="/admin" class="btn btn-secondary">
                <i class="fas fa-cog"></i> Admin Panel
            </a>
        </div>

        <div class="footer">
            <% if (thumbnail) { %>
                <img src="<%= thumbnail %>" alt="Bot Logo">
            <% } %>
            <div class="footer-text">
                <i class="fas fa-shield-alt"></i> <%= footer %>
            </div>
        </div>
    </div>

    <script>
        // Sayfa yüklenme animasyonu
        window.addEventListener('load', function() {
            document.body.style.opacity = '1';
        });

        // Oy verilerini al (EJS template syntax)
        const evetCount = <%= oylar.filter(o => o.oy === 'evet').length %>;
        const hayirCount = <%= oylar.filter(o => o.oy === 'hayır').length %>;

        // Sayıları animasyonlu göster
        function animateNumber(elementId, targetNumber, duration = 1000) {
            const element = document.getElementById(elementId);
            let startNumber = 0;
            const increment = targetNumber / (duration / 16);
            
            function updateNumber() {
                startNumber += increment;
                if (startNumber >= targetNumber) {
                    element.textContent = targetNumber;
                } else {
                    element.textContent = Math.floor(startNumber);
                    requestAnimationFrame(updateNumber);
                }
            }
            updateNumber();
        }

        // Sayıları animasyonlu göster
        setTimeout(() => {
            animateNumber('evetSayisi', evetCount, 1500);
            animateNumber('hayirSayisi', hayirCount, 1500);
        }, 1000);

        // Chart.js ile pasta grafiği oluştur
        const ctx = document.getElementById('oyGrafiği').getContext('2d');
        
        // Gradient oluştur
        const evetGradient = ctx.createLinearGradient(0, 0, 0, 300);
        evetGradient.addColorStop(0, '#27ae60');
        evetGradient.addColorStop(1, '#2ecc71');
        
        const hayirGradient = ctx.createLinearGradient(0, 0, 0, 300);
        hayirGradient.addColorStop(0, '#e74c3c');
        hayirGradient.addColorStop(1, '#f39c12');

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Evet', 'Hayır'],
                datasets: [{
                    data: [evetCount, hayirCount],
                    backgroundColor: [evetGradient, hayirGradient],
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverBorderWidth: 5,
                    hoverBorderColor: '#74b9ff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            font: {
                                size: 14,
                                weight: 'bold'
                            },
                            color: '#2d3436'
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#74b9ff',
                        borderWidth: 2,
                        cornerRadius: 10,
                        displayColors: true
                    }
                },
                animation: {
                    animateRotate: true,
                    animateScale: true,
                    duration: 2000,
                    easing: 'easeOutQuart'
                },
                cutout: '50%'
            }
        });

        // Hover efektleri
        document.querySelectorAll('.detail-item, .vote-item').forEach(item => {
            item.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px) scale(1.02)';
            });
            
            item.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });

        // Sayfa tıklama efekti
        document.addEventListener('click', function(e) {
            const ripple = document.createElement('div');
            ripple.style.cssText = `
                position: absolute;
                border-radius: 50%;
                background: rgba(116, 185, 255, 0.3);
                transform: scale(0);
                animation: ripple-effect 0.6s linear;
                pointer-events: none;
                left: ${e.clientX - 25}px;
                top: ${e.clientY - 25}px;
                width: 50px;
                height: 50px;
                z-index: 9999;
            `;
            
            const style = document.createElement('style');
            style.textContent = `
                @keyframes ripple-effect {
                    to {
                        transform: scale(4);
                        opacity: 0;
                    }
                }
            `;
            document.head.appendChild(style);
            document.body.appendChild(ripple);
            
            setTimeout(() => {
                ripple.remove();
                style.remove();
            }, 600);
        });

        // Smooth scroll için
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });
    </script>
</body>

</html>