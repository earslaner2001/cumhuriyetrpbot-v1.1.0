<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= kanun.baslik %> - Cumhuriyet RP Bot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-red: #C41E3A;
            --dark-red: #8B1429;
            --text-dark: #2C2C2C;
            --text-muted: #7A7A7A;
            --bg-light: #F5F5F5;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(135deg, #C41E3A 0%, #8B1429 100%);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,%3Csvg width="60" height="60" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M30 0l5 10h10l-8 6 3 10-10-7-10 7 3-10-8-6h10z" fill="rgba(255,255,255,0.03)"/%3E%3C/svg%3E') repeat;
            opacity: 0.3;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 2rem;
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .kanun-card {
            background: white;
            border-radius: 20px;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .kanun-header {
            border-bottom: 3px solid var(--bg-light);
            padding-bottom: 2rem;
            margin-bottom: 2rem;
        }

        .kanun-id-badge {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
            color: white;
            padding: 10px 24px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
        }

        .kanun-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 1.5rem;
            line-height: 1.3;
        }

        .kanun-meta {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .status-badge {
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .status-yürürlükte {
            background: #d4edda;
            color: #155724;
        }

        .status-oylamada {
            background: #d1ecf1;
            color: #0c5460;
        }

        .status-taslak {
            background: #fff3cd;
            color: #856404;
        }

        .status-reddedildi {
            background: #f8d7da;
            color: #721c24;
        }

        .meta-item {
            color: var(--text-muted);
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .kanun-section {
            margin-bottom: 2.5rem;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--text-dark);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-content {
            background: var(--bg-light);
            padding: 2rem;
            border-radius: 12px;
            line-height: 1.8;
            color: var(--text-dark);
            font-size: 1.05rem;
        }

        .section-content p {
            margin: 0.75rem 0;
        }

        .section-content p:first-child {
            margin-top: 0;
        }

        .section-content p:last-child {
            margin-bottom: 0;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .info-item {
            background: var(--bg-light);
            padding: 1.5rem;
            border-radius: 12px;
            border-left: 4px solid var(--primary-red);
        }

        .info-label {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-value {
            color: var(--text-dark);
            font-size: 1.2rem;
            font-weight: 600;
        }

        .oylar-section {
            background: var(--bg-light);
            padding: 2rem;
            border-radius: 12px;
            margin-top: 2rem;
        }

        .oylar-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--text-dark);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .oy-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .oy-stat {
            background: white;
            padding: 1.2rem;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .oy-stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.3rem;
        }

        .oy-stat-label {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 500;
        }

        .oy-evet .oy-stat-number {
            color: #27ae60;
        }

        .oy-hayir .oy-stat-number {
            color: #e74c3c;
        }

        .oy-cekinser .oy-stat-number {
            color: #95a5a6;
        }

        .progress-bar {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            height: 30px;
            display: flex;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .progress-segment {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .progress-evet {
            background: #27ae60;
        }

        .progress-hayir {
            background: #e74c3c;
        }

        .progress-cekinser {
            background: #95a5a6;
        }

        .oy-listesi {
            margin-top: 1.5rem;
        }

        .oy-item {
            background: white;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .oy-icon {
            font-size: 1.5rem;
        }

        .oy-text {
            color: var(--text-dark);
            font-weight: 500;
        }

        .actions {
            display: flex;
            gap: 1rem;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 3px solid var(--bg-light);
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
            color: white;
        }

        .btn-primary:hover {
            box-shadow: 0 8px 20px rgba(196, 30, 58, 0.3);
        }

        .btn-secondary {
            background: var(--bg-light);
            color: var(--text-dark);
        }

        .btn-secondary:hover {
            background: #e0e0e0;
        }

        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }

            .kanun-card {
                padding: 2rem 1.5rem;
            }

            .kanun-title {
                font-size: 2rem;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .kanun-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-btn">
            ← Ana Sayfaya Dön
        </a>

        <div class="kanun-card">
            <div class="kanun-header">
                <div class="kanun-id-badge">
                    📜 Kanun #<%= kanun.id %>
                </div>
                
                <h1 class="kanun-title">
                    <%= kanun.baslik %>
                </h1>

                <div class="kanun-meta">
                    <span class="status-badge status-<%= kanun.durum.toLowerCase() %>">
                        <% if (kanun.durum === 'Taslak') { %>
                            📝 Taslak
                        <% } else if (kanun.durum === 'Oylamada') { %>
                            🗳️ Oylamada
                        <% } else if (kanun.durum === 'Yürürlükte') { %>
                            ✅ Yürürlükte
                        <% } else if (kanun.durum === 'Reddedildi') { %>
                            ❌ Reddedildi
                        <% } %>
                    </span>

                    <% if (kanun.zaman) { %>
                        <span class="meta-item">
                            📅 <%= new Date(kanun.zaman).toLocaleDateString('tr-TR', { 
                                day: 'numeric', 
                                month: 'long', 
                                year: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </span>
                    <% } %>
                </div>
            </div>

            <div class="kanun-section">
                <h2 class="section-title">
                    📋 Açıklama
                </h2>
                <div class="section-content">
                    <%= kanun.icerik || 'Açıklama bulunmamaktadır.' %>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Durum</div>
                    <div class="info-value"><%= kanun.durum %></div>
                </div>

                <% if (kanun.oylar_evet !== null && kanun.oylar_evet !== undefined) { %>
                    <div class="info-item">
                        <div class="info-label">Toplam Oy</div>
                        <div class="info-value">
                            <%= (kanun.oylar_evet || 0) + (kanun.oylar_hayir || 0) + (kanun.oylar_cekinser || 0) %>
                        </div>
                    </div>
                <% } %>

                <% if (kanun.teklif_eden_id) { %>
                    <div class="info-item">
                        <div class="info-label">Teklif Eden</div>
                        <div class="info-value">👤 User ID: <%= kanun.teklif_eden_id %></div>
                    </div>
                <% } %>

                <% if (kanun.yururluge_giris_sekli) { %>
                    <div class="info-item">
                        <div class="info-label">Yürürlüğe Giriş</div>
                        <div class="info-value"><%= kanun.yururluge_giris_sekli %></div>
                    </div>
                <% } %>
            </div>

            <% if (oylar && oylar.length > 0) { %>
                <div class="oylar-section">
                    <h3 class="oylar-title">
                        🗳️ Oylama Sonuçları
                    </h3>

                    <div class="oy-stats">
                        <div class="oy-stat oy-evet">
                            <div class="oy-stat-number"><%= kanun.oylar_evet || 0 %></div>
                            <div class="oy-stat-label">Evet</div>
                        </div>
                        <div class="oy-stat oy-hayir">
                            <div class="oy-stat-number"><%= kanun.oylar_hayir || 0 %></div>
                            <div class="oy-stat-label">Hayır</div>
                        </div>
                        <div class="oy-stat oy-cekinser">
                            <div class="oy-stat-number"><%= kanun.oylar_cekinser || 0 %></div>
                            <div class="oy-stat-label">Çekimser</div>
                        </div>
                    </div>

                    <% 
                    const toplamOy = (kanun.oylar_evet || 0) + (kanun.oylar_hayir || 0) + (kanun.oylar_cekinser || 0);
                    const evetYuzde = toplamOy > 0 ? ((kanun.oylar_evet || 0) / toplamOy * 100).toFixed(1) : 0;
                    const hayirYuzde = toplamOy > 0 ? ((kanun.oylar_hayir || 0) / toplamOy * 100).toFixed(1) : 0;
                    const cekinserYuzde = toplamOy > 0 ? ((kanun.oylar_cekinser || 0) / toplamOy * 100).toFixed(1) : 0;
                    %>

                    <div class="progress-bar">
                        <% if (evetYuzde > 0) { 
                            const evetWidth = evetYuzde + '%';
                        %>
                            <div class="progress-segment progress-evet" style="width: <%= evetWidth %>;">
                                <%= evetYuzde %>%
                            </div>
                        <% } %>
                        <% if (hayirYuzde > 0) { 
                            const hayirWidth = hayirYuzde + '%';
                        %>
                            <div class="progress-segment progress-hayir" style="width: <%= hayirWidth %>;">
                                <%= hayirYuzde %>%
                            </div>
                        <% } %>
                        <% if (cekinserYuzde > 0) { 
                            const cekinserWidth = cekinserYuzde + '%';
                        %>
                            <div class="progress-segment progress-cekinser" style="width: <%= cekinserWidth %>;">
                                <%= cekinserYuzde %>%
                            </div>
                        <% } %>
                    </div>

                    <div class="oy-listesi">
                        <% oylar.slice(0, 10).forEach(oy => { %>
                            <div class="oy-item">
                                <span class="oy-icon">
                                    <% const oyLower = (oy.oy || '').toLowerCase(); %>
                                    <% if (oyLower === 'evet') { %>
                                        ✅
                                    <% } else if (oyLower === 'hayır' || oyLower === 'hayir') { %>
                                        ❌
                                    <% } else { %>
                                        ⚪
                                    <% } %>
                                </span>
                                <span class="oy-text">
                                    <strong><%= oy.oy %></strong>
                                </span>
                            </div>
                        <% }); %>
                        <% if (oylar.length > 10) { %>
                            <div style="text-align: center; margin-top: 1rem; color: var(--text-muted);">
                                ve <%= oylar.length - 10 %> oy daha...
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } else { %>
                <div class="oylar-section" style="text-align: center; padding: 3rem;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
                    <h3 style="color: var(--text-muted); font-size: 1.2rem;">Henüz oy kullanılmamış</h3>
                </div>
            <% } %>

            <div class="actions">
                <a href="/" class="btn btn-primary">
                    🏠 Ana Sayfa
                </a>
                <a href="/admin" class="btn btn-secondary">
                    🔐 Admin Paneli
                </a>
            </div>
        </div>
    </div>

    <script>
        // Discord markdown'ını HTML'e dönüştürme fonksiyonu
        function parseDiscordMarkdown(text) {
            if (!text) return '';
            
            // String literal \n'leri gerçek satır sonlarına çevir
            text = text.replace(/\\n/g, '\n');
            
            // HTML karakterlerini escape et
            text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            
            // Code blocks (```kod```)
            text = text.replace(/```([\s\S]*?)```/g, '<pre style="background: #2f3136; color: #dcddde; padding: 8px; border-radius: 4px; overflow-x: auto; margin: 8px 0;"><code>$1</code></pre>');
            
            // Inline code (`kod`)
            text = text.replace(/`([^`]+)`/g, '<code style="background: #2f3136; color: #dcddde; padding: 2px 6px; border-radius: 3px; font-family: monospace;">$1</code>');
            
            // Strikethrough (~~strikethrough~~)
            text = text.replace(/~~([^~]+)~~/g, '<s style="text-decoration: line-through;">$1</s>');
            
            // Bold with ** (**bold**)
            text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
            
            // Underline with __ (__underline__)
            text = text.replace(/__([^_]+)__/g, '<u style="text-decoration: underline;">$1</u>');
            
            // Italic with single * (*italic*)
            text = text.replace(/\*([^*]+?)\*/g, '<em>$1</em>');
            
            // Italic with single _ (_italic_)
            text = text.replace(/(^|\s)_([^_]+?)_($|\s)/g, '$1<em>$2</em>$3');
            
            // Blockquote (> quote)
            text = text.replace(/^&gt;\s*(.+)$/gm, '<blockquote style="border-left: 4px solid #4e5058; padding-left: 12px; color: #b9bbbe; margin: 4px 0;">$1</blockquote>');
            
            // Links ([text](url))
            text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" style="color: #00b0f4; text-decoration: none;">$1</a>');
            
            // Çift satır sonlarını paragraf ayırıcı olarak kullan
            text = text.replace(/\n\n+/g, '</p><p>');
            
            // Tek satır sonlarını br'ye çevir
            text = text.replace(/\n/g, '<br>');
            
            // Paragraf etiketleriyle sarmala
            text = '<p>' + text + '</p>';
            
            // Boş paragrafları temizle
            text = text.replace(/<p>\s*<\/p>/g, '');
            
            return text;
        }

        // Sayfa yüklendiğinde kanun içeriğini formatla
        document.addEventListener('DOMContentLoaded', function() {
            const contentElement = document.querySelector('.section-content');
            if (contentElement) {
                const rawText = contentElement.textContent;
                contentElement.innerHTML = parseDiscordMarkdown(rawText);
            }
        });
    </script>
</body>
</html>
