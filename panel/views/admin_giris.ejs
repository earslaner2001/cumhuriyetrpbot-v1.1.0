<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Girişi - Cumhuriyet RP Bot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-red: #C41E3A;
            --dark-red: #8B1429;
            --text-dark: #2C2C2C;
            --text-muted: #7A7A7A;
            --bg-light: #F5F5F5;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(135deg, #C41E3A 0%, #8B1429 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,%3Csvg width="60" height="60" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M30 0l5 10h10l-8 6 3 10-10-7-10 7 3-10-8-6h10z" fill="rgba(255,255,255,0.03)"/%3E%3C/svg%3E') repeat;
            opacity: 0.3;
        }

        .login-container {
            background: white;
            padding: 50px 40px;
            border-radius: 16px;
            box-shadow: 0 20px 80px rgba(0, 0, 0, 0.4);
            width: 100%;
            max-width: 450px;
            position: relative;
            z-index: 1;
        }

        .logo-section {
            text-align: center;
            margin-bottom: 35px;
        }

        .logo-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #C41E3A 0%, #8B1429 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .logo-icon svg {
            width: 45px;
            height: 45px;
            fill: white;
        }

        .title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary-red);
            margin-bottom: 8px;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .error-message {
            background: linear-gradient(135deg, #ff4757 0%, #e84118 100%);
            color: white;
            padding: 14px 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            text-align: center;
            font-size: 0.9rem;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-dark);
            font-weight: 500;
            font-size: 0.9rem;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper svg {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            fill: var(--text-muted);
        }

        .form-control {
            width: 100%;
            padding: 14px 15px 14px 45px;
            border: 2px solid #E5E5E5;
            border-radius: 8px;
            font-size: 1rem;
            font-family: 'Roboto', sans-serif;
            background: #fafafa;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-red);
            background: white;
            box-shadow: 0 4px 12px rgba(196, 30, 58, 0.15);
        }

        .form-control:focus + svg {
            fill: var(--primary-red);
        }

        .btn-login {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #C41E3A 0%, #8B1429 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            font-family: 'Roboto', sans-serif;
        }

        .btn-login:hover {
            box-shadow: 0 12px 24px rgba(196, 30, 58, 0.4);
        }

        .footer-text {
            text-align: center;
            margin-top: 30px;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .version {
            display: inline-block;
            background: var(--bg-light);
            padding: 4px 12px;
            border-radius: 20px;
            margin-top: 10px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        @media (max-width: 480px) {
            .login-container {
                margin: 20px;
                padding: 40px 30px;
            }

            .title {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo-section">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5zm0 10c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm0 1c1.93 0 3.5 1.57 3.5 3.5V18h-7v-1.5c0-1.93 1.57-3.5 3.5-3.5z"/>
                </svg>
            </div>
            <h1 class="title">Admin Paneli</h1>
            <p class="subtitle">Cumhuriyet RP Bot Yönetim</p>
        </div>

        <% if (hata) { %>
            <div class="error-message">
                ⚠️ <%= hata %>
            </div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label for="username">Kullanıcı Adı</label>
                <div class="input-wrapper">
                    <input type="text" id="username" name="username" class="form-control" 
                           placeholder="Kullanıcı adınızı girin" required autofocus>
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                </div>
            </div>

            <div class="form-group">
                <label for="password">Şifre</label>
                <div class="input-wrapper">
                    <input type="password" id="password" name="password" class="form-control" 
                           placeholder="Şifrenizi girin" required>
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                    </svg>
                </div>
            </div>

            <button type="submit" class="btn-login">
                🔐 Giriş Yap
            </button>
        </form>

        <div class="footer-text">
            🛡️ Güvenli Bağlantı
            <div class="version">v1.1.1</div>
        </div>
    </div>

    <script>
        // Auto-focus input
        document.getElementById('username').focus();
    </script>
</body>
</html>
