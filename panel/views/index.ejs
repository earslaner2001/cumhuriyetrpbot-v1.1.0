<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kanun Takip Sistemi - Cumhuriyet RP Bot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-red: #C41E3A;
            --dark-red: #8B1429;
            --text-dark: #2C2C2C;
            --text-muted: #7A7A7A;
            --bg-light: #F5F5F5;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(135deg, #C41E3A 0%, #8B1429 100%);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,%3Csvg width="60" height="60" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M30 0l5 10h10l-8 6 3 10-10-7-10 7 3-10-8-6h10z" fill="rgba(255,255,255,0.03)"/%3E%3C/svg%3E') repeat;
            opacity: 0.3;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 800;
            color: white;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            margin-bottom: 1rem;
        }

        .header .subtitle {
            font-size: 1.3rem;
            color: rgba(255, 255, 255, 0.95);
            font-weight: 300;
        }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        .stat-card:hover {
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
        }

        .stat-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            font-weight: 700;
            color: var(--primary-red);
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: var(--text-muted);
            font-weight: 500;
            font-size: 1rem;
        }

        .kanun-list {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }

        .kanun-list h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            color: var(--text-dark);
            margin-bottom: 2rem;
            text-align: center;
            position: relative;
            padding-bottom: 1rem;
        }

        .kanun-list h2::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-red), var(--dark-red));
            border-radius: 2px;
        }

        .kanun-item {
            background: var(--bg-light);
            margin-bottom: 1.5rem;
            padding: 2rem;
            border-radius: 16px;
            border-left: 5px solid var(--primary-red);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            cursor: pointer;
        }

        .kanun-item:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        }

        .kanun-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .kanun-id {
            background: var(--primary-red);
            color: white;
            padding: 8px 18px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .kanun-baslik {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--text-dark);
            margin: 1rem 0;
        }

        .kanun-aciklama {
            color: var(--text-muted);
            line-height: 1.6;
            margin: 1rem 0;
        }

        .kanun-aciklama p {
            margin: 0.75rem 0;
        }

        .kanun-aciklama p:first-child {
            margin-top: 0;
        }

        .kanun-aciklama p:last-child {
            margin-bottom: 0;
        }

        .kanun-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 2px solid rgba(0, 0, 0, 0.05);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .kanun-status {
            padding: 8px 18px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-yürürlükte {
            background: #d4edda;
            color: #155724;
        }

        .status-oylamada {
            background: #d1ecf1;
            color: #0c5460;
        }

        .status-taslak {
            background: #fff3cd;
            color: #856404;
        }

        .status-reddedildi {
            background: #f8d7da;
            color: #721c24;
        }

        .kanun-date {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .detay-btn {
            background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
            color: white;
            padding: 10px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
        }

        .detay-btn:hover {
            box-shadow: 0 6px 16px rgba(196, 30, 58, 0.3);
        }

        .admin-btn {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            padding: 16px 28px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            box-shadow: 0 8px 24px rgba(52, 152, 219, 0.4);
            z-index: 1000;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .admin-btn:hover {
            box-shadow: 0 12px 32px rgba(52, 152, 219, 0.6);
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--text-muted);
        }

        .empty-state svg {
            width: 150px;
            height: 150px;
            fill: #ddd;
            margin-bottom: 2rem;
        }

        .footer {
            text-align: center;
            margin-top: 3rem;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            color: white;
            font-size: 1rem;
        }

        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }

            .header h1 {
                font-size: 2.5rem;
            }

            .stats-row {
                grid-template-columns: 1fr;
            }

            .kanun-header {
                flex-direction: column;
                gap: 0.5rem;
                align-items: flex-start;
            }

            .kanun-footer {
                flex-direction: column;
                align-items: flex-start;
            }

            .admin-btn {
                bottom: 1rem;
                right: 1rem;
                padding: 14px 24px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📜 Kanun Takip Sistemi</h1>
            <p class="subtitle">Cumhuriyet RP Bot v1.1.1</p>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon">✅</div>
                <div class="stat-number"><%= kanunlar.filter(k => k.durum === 'Yürürlükte').length %></div>
                <div class="stat-label">Yürürlükte</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🗳️</div>
                <div class="stat-number"><%= kanunlar.filter(k => k.durum === 'Oylamada').length %></div>
                <div class="stat-label">Oylamada</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📝</div>
                <div class="stat-number"><%= kanunlar.filter(k => k.durum === 'Taslak').length %></div>
                <div class="stat-label">Taslak</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📊</div>
                <div class="stat-number"><%= kanunlar.length %></div>
                <div class="stat-label">Toplam</div>
            </div>
        </div>

        <div class="kanun-list">
            <h2>⚖️ Kanunlar</h2>

            <% if (kanunlar.length === 0) { %>
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                    </svg>
                    <h3 style="font-size: 2rem; margin-bottom: 1rem; color: var(--text-dark);">Henüz Kanun Yok</h3>
                    <p style="font-size: 1.1rem;">Discord botunu kullanarak yeni kanun teklifleri oluşturabilirsiniz.</p>
                </div>
            <% } else { %>
                <% kanunlar.forEach(k => { %>
                    <div class="kanun-item">
                        <div class="kanun-header">
                            <div class="kanun-id">
                                #<%= k.id %>
                            </div>
                        </div>
                        
                        <div class="kanun-baslik">
                            <%= k.baslik %>
                        </div>
                        
                        <% if (k.icerik) { %>
                            <div class="kanun-aciklama">
                                <%= k.icerik.length > 200 ? k.icerik.substring(0, 200) + '...' : k.icerik %>
                            </div>
                        <% } %>
                        
                        <div class="kanun-footer">
                            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                                <span class="kanun-status status-<%= k.durum.toLowerCase() %>">
                                    <% if (k.durum === 'Taslak') { %>
                                        📝 Taslak
                                    <% } else if (k.durum === 'Oylamada') { %>
                                        🗳️ Oylamada
                                    <% } else if (k.durum === 'Yürürlükte') { %>
                                        ✅ Yürürlükte
                                    <% } else if (k.durum === 'Reddedildi') { %>
                                        ❌ Reddedildi
                                    <% } %>
                                </span>
                                
                                <% if (k.zaman) { %>
                                    <span class="kanun-date">
                                        📅 <%= new Date(k.zaman).toLocaleDateString('tr-TR', { 
                                            day: 'numeric', 
                                            month: 'long', 
                                            year: 'numeric' 
                                        }) %>
                                    </span>
                                <% } %>
                            </div>
                            
                            <a href="/kanun/<%= k.id %>" class="detay-btn">
                                Detayları Gör →
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>

        <div class="footer">
            🛡️ Cumhuriyet RP Bot v1.1.1 - Kanun Takip ve Yönetim Sistemi
        </div>
    </div>

    <a href="/admin" class="admin-btn">
        🔐 Admin Paneli
    </a>

    <script>
        // Discord markdown'ını HTML'e dönüştürme fonksiyonu
        function parseDiscordMarkdown(text) {
            if (!text) return '';
            
            // String literal \n'leri gerçek satır sonlarına çevir
            text = text.replace(/\\n/g, '\n');
            
            // HTML karakterlerini escape et
            text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            
            // Code blocks (```kod```)
            text = text.replace(/```([\s\S]*?)```/g, '<pre style="background: #2f3136; color: #dcddde; padding: 8px; border-radius: 4px; overflow-x: auto; margin: 8px 0;"><code>$1</code></pre>');
            
            // Inline code (`kod`)
            text = text.replace(/`([^`]+)`/g, '<code style="background: #2f3136; color: #dcddde; padding: 2px 6px; border-radius: 3px; font-family: monospace;">$1</code>');
            
            // Strikethrough (~~strikethrough~~)
            text = text.replace(/~~([^~]+)~~/g, '<s style="text-decoration: line-through;">$1</s>');
            
            // Bold with ** (**bold**)
            text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
            
            // Underline with __ (__underline__)
            text = text.replace(/__([^_]+)__/g, '<u style="text-decoration: underline;">$1</u>');
            
            // Italic with single * (*italic*)
            text = text.replace(/\*([^*]+?)\*/g, '<em>$1</em>');
            
            // Italic with single _ (_italic_)
            text = text.replace(/(^|\s)_([^_]+?)_($|\s)/g, '$1<em>$2</em>$3');
            
            // Blockquote (> quote)
            text = text.replace(/^&gt;\s*(.+)$/gm, '<blockquote style="border-left: 4px solid #4e5058; padding-left: 12px; color: #b9bbbe; margin: 4px 0;">$1</blockquote>');
            
            // Links ([text](url))
            text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" style="color: #00b0f4; text-decoration: none;">$1</a>');
            
            // Çift satır sonlarını paragraf ayırıcı olarak kullan
            text = text.replace(/\n\n+/g, '</p><p>');
            
            // Tek satır sonlarını br'ye çevir
            text = text.replace(/\n/g, '<br>');
            
            // Paragraf etiketleriyle sarmala
            text = '<p>' + text + '</p>';
            
            // Boş paragrafları temizle
            text = text.replace(/<p>\s*<\/p>/g, '');
            
            return text;
        }

        // Sayfa yüklendiğinde tüm kanun açıklamalarını formatla
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.kanun-aciklama').forEach(function(element) {
                const rawText = element.textContent;
                element.innerHTML = parseDiscordMarkdown(rawText);
            });
        });
    </script>
</body>
</html>
